{
  "name": "ravenmoor-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isometric medieval web MMORPG — authoritative Node server, no runtime dependencies",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning tools/test-multiplayer.mjs",
    "load": "node --disable-warning=ExperimentalWarning tools/load-test.mjs 40 60",
    "bake": "node tools/bake/bake.cjs",
    "fetch-assets": "bash tools/fetch-assets.sh"
  },
  "engines": { "node": ">=22.13" }
}
